# Frontend image for Kubernetes: static React build served by nginx.
# The build stage runs on the host platform (it only produces static files),
# so cross-building for amd64 on an arm64 Mac stays fast.
FROM --platform=$BUILDPLATFORM node:20-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm install --production=false

COPY . .

# Call the API through nginx's /api/ proxy instead of a hard-coded localhost URL
ENV REACT_APP_API_URL=/api
RUN npm run build

FROM nginx:alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build /usr/share/nginx/html

EXPOSE 80
